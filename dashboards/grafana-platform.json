            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "queue_depth",
          "legendFormat": "{{queue}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
