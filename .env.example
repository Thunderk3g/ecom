NODE_ENV=development
ROLE=web
PORT=3000
LOG_LEVEL=debug

# Postgres — docker-compose starts one locally
DATABASE_URL=postgres://app_migrator:dev_password@localhost:5433/ecommerce

# Redis — docker-compose starts one locally
REDIS_URL=redis://localhost:6380

# Auth — generate with: openssl rand -hex 32
# Deliberately shorter than 32 chars so parseEnv() fails loudly if left unset.
SESSION_SECRET=CHANGE_ME

# Cookie scope
COOKIE_DOMAIN=localhost

# Imgproxy (SP-8 image pipeline). docker-compose.dev.yml starts one locally.
# The R2Provider reads IMGPROXY_BASE_URL; the Next.js custom image loader also
# accepts IMGPROXY_URL for parity with the imgproxy docs.
IMGPROXY_URL=http://localhost:8081
IMGPROXY_BASE_URL=http://localhost:8081
IMGPROXY_KEY=dev_imgproxy_key
IMGPROXY_SALT=dev_imgproxy_salt

# Media pipeline. 'stub' (default) discards bytes — dev/test only.
# 'supabase-storage' is the deployed provider; 'r2-imgproxy' is the legacy path.
MEDIA_PROVIDER=stub

# Supabase Storage provider (MEDIA_PROVIDER=supabase-storage).
# SUPABASE_SERVICE_ROLE_KEY is the SECRET key: server-only, bypasses RLS.
# NEVER give it a NEXT_PUBLIC_ name and never commit a real value.
# SUPABASE_STORAGE_TRANSFORM enables Supabase image resizing — a PAID feature,
# so it stays 'false' on the free tier (derivative URLs serve the original).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_TRANSFORM=false

# Supabase JS client (src/utils/supabase/{client,server,middleware}.ts).
# Publishable key only — browser-safe. NEVER put the secret/service_role key
# behind a NEXT_PUBLIC_ name; NEXT_PUBLIC_* is shipped to the browser.
# NEXT_PUBLIC_* is inlined at build time: redeploy after changing these.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
